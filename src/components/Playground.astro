---
const modes = [
  { id: 'type', label: 'Type' },
  { id: 'flow', label: 'Flow' },
  { id: 'swarm', label: 'Swarm' },
]

// Sketches from editor.p5js.org/pasha.korolchukk — `id` is the last part of
// the sketch URL. They load in an iframe only after a click.
const user = 'pasha.korolchukk'
const editor = `https://editor.p5js.org/${user}/sketches/`
const sketches = [
  { id: 'tgTrbJEj8', title: 'Isometric buildings', note: 'A scattered isometric town. The houses sink under the cursor.' },
  { id: 'XyZwg6p08', title: 'Switch particles', note: 'Four generative modes in one sketch — click it, then press 1–4.' },
  { id: 'wBrBSAAb7', title: 'Pattern tiles', note: 'A grid of generated patterns that shrink to miniatures on hover.' },
  { id: 'PeeNmINy7', title: 'Watery ink', note: 'Ink-like ripples from a small wave simulation. Generate for a new seed.' },
]
---

<section id="play" class="sec play t-ink" data-log="run ~/playground/sketch.js">
  <header class="sec-head">
    <span class="sec-head__no mono">§ 04</span>
    <h2 class="sec-head__title display">Playground</h2>
    <p class="sec-head__note mono">A live particle sketch. Plain canvas, no libraries</p>
  </header>

  <div class="play__stage" data-reveal>
    <canvas class="play__canvas js-play" aria-label="Interactive particle sketch" data-cursor="push · click to burst"></canvas>
    <p class="play__hud mono js-play-hud" aria-hidden="true"></p>
    <p class="play__hint mono" aria-hidden="true">Move to push · click to burst · type your own word below</p>
  </div>

  <div class="play__panel mono">
    <div class="play__group" role="group" aria-label="Mode">
      <span class="play__label">Mode</span>
      {
        modes.map((m, i) => (
          <button type="button" data-mode={m.id} class={i === 0 ? 'is-active' : ''} aria-pressed={i === 0 ? 'true' : 'false'}>
            {m.label}
          </button>
        ))
      }
    </div>

    <label class="play__group">
      <span class="play__label">Text</span>
      <input class="play__text js-play-text" type="text" maxlength="12" value="HELLO" spellcheck="false" autocomplete="off" data-cursor="type" />
    </label>

    <label class="play__group">
      <span class="play__label">Particles</span>
      <input class="js-play-count" type="range" min="400" max="5000" step="100" value="2400" />
      <output class="js-play-count-out">2400</output>
    </label>

    <label class="play__group">
      <span class="play__label">Speed</span>
      <input class="js-play-speed" type="range" min="0.3" max="2.5" step="0.1" value="1" />
    </label>

    <div class="play__group">
      <button type="button" data-act="reseed">Scatter</button>
      <button type="button" data-act="save">Save PNG</button>
    </div>
  </div>

  <div class="shelf">
    <p class="shelf__head mono">
      <span>p5.js sketchbook</span>
      <span>{sketches.length} sketches · run live from editor.p5js.org</span>
    </p>

    <div class="shelf__grid">
      <ol class="shelf__list">
        {
          sketches.map((s, i) => (
            <li>
              <button type="button" class="shelf__item" data-id={s.id} data-title={s.title} data-cursor="run" aria-pressed="false">
                <span class="shelf__no mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="shelf__title display">{s.title}</span>
                <span class="shelf__note">{s.note}</span>
              </button>
            </li>
          ))
        }
      </ol>

      <div class="shelf__view">
        <div class="shelf__frame js-shelf-frame">
          <button type="button" class="shelf__run mono js-shelf-run" data-cursor="run">Run sketch ▶</button>
        </div>
        <p class="shelf__bar mono">
          <span class="js-shelf-title">{sketches[0].title}</span>
          <a class="ul js-shelf-link" href={editor + sketches[0].id} target="_blank" rel="noopener">Open in p5 editor ↗</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { log, reducedMotion } from '../lib/log'

  type Mode = 'type' | 'flow' | 'swarm'

  const section = document.querySelector<HTMLElement>('.play')!
  const stage = section.querySelector<HTMLElement>('.play__stage')!
  const canvas = section.querySelector<HTMLCanvasElement>('.js-play')!
  const ctx = canvas.getContext('2d')!
  const hud = section.querySelector<HTMLElement>('.js-play-hud')!
  const modeBtns = section.querySelectorAll<HTMLButtonElement>('[data-mode]')
  const textInput = section.querySelector<HTMLInputElement>('.js-play-text')!
  const countInput = section.querySelector<HTMLInputElement>('.js-play-count')!
  const countOut = section.querySelector<HTMLElement>('.js-play-count-out')!
  const speedInput = section.querySelector<HTMLInputElement>('.js-play-speed')!

  const calm = reducedMotion()
  const MAX = 5000

  // Particle state lives in flat typed arrays
  const x = new Float32Array(MAX)
  const y = new Float32Array(MAX)
  const vx = new Float32Array(MAX)
  const vy = new Float32Array(MAX)
  const tx = new Float32Array(MAX)
  const ty = new Float32Array(MAX)

  let mode: Mode = 'type'
  let text = textInput.value
  let speed = 1
  let count = window.innerWidth < 720 ? 1200 : Number(countInput.value)
  countInput.value = String(count)
  countOut.textContent = String(count)

  let w = 0
  let h = 0
  let seeded = false
  let running = false
  let visible = false
  let raf = 0
  let frames = 0
  let fps = 0
  let fpsAt = 0

  let bg = [22, 0, 0]
  let fg = '#fff0eb'
  let accent = '#f40c3f'

  const pointer = { x: 0, y: 0, active: false }

  /* Setup --------------------------------------------------------- */

  const hex = (value: string) => {
    const v = value.trim()
    if (!/^#[0-9a-f]{6}$/i.test(v)) return null
    return [parseInt(v.slice(1, 3), 16), parseInt(v.slice(3, 5), 16), parseInt(v.slice(5, 7), 16)]
  }

  const wipe = () => {
    ctx.fillStyle = `rgb(${bg.join(',')})`
    ctx.fillRect(0, 0, w, h)
  }

  const readColors = () => {
    const cs = getComputedStyle(section)
    bg = hex(cs.getPropertyValue('--bg')) ?? bg
    fg = cs.getPropertyValue('--fg').trim() || fg
    accent = cs.getPropertyValue('--accent').trim() || accent
    wipe()
    if (!running) still()
  }

  const scatter = () => {
    for (let i = 0; i < MAX; i++) {
      x[i] = Math.random() * w
      y[i] = Math.random() * h
      vx[i] = (Math.random() - 0.5) * 2
      vy[i] = (Math.random() - 0.5) * 2
    }
    seeded = true
  }

  // Rasterise the word off-screen and hand every particle a pixel of it
  const buildTargets = () => {
    if (!w || !h) return

    const word = (text.trim() || 'PK').toUpperCase()
    const off = document.createElement('canvas')
    off.width = w
    off.height = h
    const o = off.getContext('2d', { willReadFrequently: true })!
    const family = '"Big Shoulders Display Variable", Impact, "Arial Narrow", sans-serif'

    o.font = `900 200px ${family}`
    const size = Math.min((200 * w * 0.88) / Math.max(o.measureText(word).width, 1), h * 0.74)
    o.font = `900 ${size}px ${family}`
    o.textAlign = 'center'
    o.textBaseline = 'middle'
    o.fillStyle = '#fff'
    o.fillText(word, w / 2, h / 2 + size * 0.04)

    const data = o.getImageData(0, 0, w, h).data
    const step = 3
    const points: number[] = []
    for (let py = 0; py < h; py += step) {
      for (let px = 0; px < w; px += step) {
        if (data[(py * w + px) * 4 + 3] > 128) points.push(px, py)
      }
    }

    const total = points.length / 2
    if (!total) return

    // Shuffle the pixels so any number of particles covers the word evenly
    for (let i = total - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      const ax = points[i * 2]
      const ay = points[i * 2 + 1]
      points[i * 2] = points[j * 2]
      points[i * 2 + 1] = points[j * 2 + 1]
      points[j * 2] = ax
      points[j * 2 + 1] = ay
    }

    for (let i = 0; i < MAX; i++) {
      const p = (i % total) * 2
      tx[i] = points[p] + (Math.random() - 0.5) * step
      ty[i] = points[p + 1] + (Math.random() - 0.5) * step
    }
  }

  const resize = () => {
    const nw = stage.clientWidth
    const nh = stage.clientHeight
    if (!nw || !nh || (nw === w && nh === h)) return

    w = nw
    h = nh
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5)
    canvas.width = Math.round(w * dpr)
    canvas.height = Math.round(h * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)

    if (!seeded) scatter()
    buildTargets()
    wipe()
    if (!running) still()
  }

  /* Simulation ---------------------------------------------------- */

  const step = (t: number) => {
    const repel = pointer.active && mode !== 'swarm'

    // Swarm centre: the pointer, or a slow figure-eight when idle
    const cx = pointer.active ? pointer.x : w / 2 + Math.cos(t * 0.6) * w * 0.26
    const cy = pointer.active ? pointer.y : h / 2 + Math.sin(t * 1.1) * h * 0.24

    for (let i = 0; i < count; i++) {
      let ax = 0
      let ay = 0
      let damp = 0.94

      if (mode === 'flow') {
        const a =
          (Math.sin(x[i] * 0.0042 + t * 0.21) +
            Math.cos(y[i] * 0.0051 - t * 0.17) +
            Math.sin((x[i] + y[i]) * 0.0027 + t * 0.1)) *
          Math.PI
        ax = Math.cos(a) * 0.22
        ay = Math.sin(a) * 0.22
      } else if (mode === 'swarm') {
        const dx = cx - x[i]
        const dy = cy - y[i]
        const d = Math.hypot(dx, dy) + 0.01
        // Pull towards the centre plus a sideways push: an orbit
        ax = (dx / d) * 0.3 - (dy / d) * (0.16 + (i % 7) * 0.02)
        ay = (dy / d) * 0.3 + (dx / d) * (0.16 + (i % 7) * 0.02)
        damp = 0.965
      } else {
        ax = (tx[i] - x[i]) * 0.02
        ay = (ty[i] - y[i]) * 0.02
        damp = 0.85
      }

      if (repel) {
        const dx = x[i] - pointer.x
        const dy = y[i] - pointer.y
        const d = Math.hypot(dx, dy)
        if (d < 120 && d > 0.01) {
          const f = (1 - d / 120) * 2.2
          ax += (dx / d) * f
          ay += (dy / d) * f
        }
      }

      vx[i] = (vx[i] + ax * speed) * damp
      vy[i] = (vy[i] + ay * speed) * damp
      x[i] += vx[i] * speed
      y[i] += vy[i] * speed

      if (mode === 'flow') {
        if (x[i] < 0) x[i] += w
        else if (x[i] > w) x[i] -= w
        if (y[i] < 0) y[i] += h
        else if (y[i] > h) y[i] -= h
      }
    }
  }

  const paint = (fade: number) => {
    ctx.fillStyle = `rgba(${bg.join(',')},${fade})`
    ctx.fillRect(0, 0, w, h)

    const s = mode === 'type' ? 2 : 1.6

    ctx.fillStyle = fg
    for (let i = 0; i < count; i++) {
      if (i % 6 !== 0) ctx.fillRect(x[i], y[i], s, s)
    }

    ctx.fillStyle = accent
    for (let i = 0; i < count; i += 6) ctx.fillRect(x[i], y[i], s + 0.6, s + 0.6)
  }

  // Reduced motion: no loop, just the settled picture
  const still = () => {
    if (!w) return
    if (calm && mode === 'type') {
      for (let i = 0; i < count; i++) {
        x[i] = tx[i]
        y[i] = ty[i]
      }
    }
    paint(1)
    writeHud()
  }

  const writeHud = () => {
    hud.textContent = `${count} particles · ${mode}${calm ? '' : ` · ${fps} fps`}`
  }

  const frame = (now: number) => {
    step(now / 1000)
    paint(mode === 'type' ? 0.3 : 0.14)

    frames++
    if (now - fpsAt > 500) {
      fps = Math.round((frames * 1000) / (now - fpsAt))
      frames = 0
      fpsAt = now
      writeHud()
    }

    raf = requestAnimationFrame(frame)
  }

  const sync = () => {
    const on = visible && !document.hidden && !calm
    if (on === running) return
    running = on
    cancelAnimationFrame(raf)
    if (on) {
      fpsAt = performance.now()
      frames = 0
      raf = requestAnimationFrame(frame)
    }
  }

  const burst = (px: number, py: number) => {
    for (let i = 0; i < count; i++) {
      const dx = x[i] - px
      const dy = y[i] - py
      const d = Math.hypot(dx, dy)
      if (d < 280 && d > 0.01) {
        const f = (1 - d / 280) * 16
        vx[i] += (dx / d) * f
        vy[i] += (dy / d) * f
      }
    }
  }

  /* Controls ------------------------------------------------------ */

  const setMode = (next: Mode, quiet = false) => {
    mode = next
    modeBtns.forEach((btn) => {
      const on = btn.dataset.mode === next
      btn.classList.toggle('is-active', on)
      btn.setAttribute('aria-pressed', String(on))
    })
    if (!quiet) log(`> sketch --mode=${next}`)
    if (!running) still()
  }

  modeBtns.forEach((btn) => btn.addEventListener('click', () => setMode(btn.dataset.mode as Mode)))

  textInput.addEventListener('input', () => {
    text = textInput.value
    buildTargets()
    setMode('type', true)
  })

  textInput.addEventListener('change', () => log(`> sketch --text="${text.toUpperCase()}"`))

  countInput.addEventListener('input', () => {
    count = Number(countInput.value)
    countOut.textContent = String(count)
    if (!running) still()
  })

  speedInput.addEventListener('input', () => {
    speed = Number(speedInput.value)
  })

  section.querySelector('[data-act="reseed"]')!.addEventListener('click', () => {
    scatter()
    log('> sketch --scatter')
    if (!running) still()
  })

  section.querySelector('[data-act="save"]')!.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = 'pk-sketch.png'
      a.click()
      setTimeout(() => URL.revokeObjectURL(url), 1000)
      log('> sketch saved: pk-sketch.png')
    })
  })

  const track = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect()
    pointer.x = e.clientX - rect.left
    pointer.y = e.clientY - rect.top
    pointer.active = true
  }

  canvas.addEventListener('pointermove', track)
  canvas.addEventListener('pointerleave', () => (pointer.active = false))
  canvas.addEventListener('pointerdown', (e) => {
    track(e)
    burst(pointer.x, pointer.y)
    if (e.pointerType === 'touch') pointer.active = false
  })

  // The terminal can drive the sketch: `play type hello`
  document.addEventListener('pk:play', (e) => {
    const detail = (e as CustomEvent<{ mode?: Mode; text?: string }>).detail || {}
    if (detail.text) {
      text = detail.text.slice(0, 12)
      textInput.value = text.toUpperCase()
      buildTargets()
    }
    if (detail.mode) setMode(detail.mode, true)
  })

  document.addEventListener('pk:theme', readColors)
  document.addEventListener('visibilitychange', sync)
  document.fonts?.ready.then(() => {
    buildTargets()
    if (!running) still()
  })

  new ResizeObserver(resize).observe(stage)
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting
    sync()
  }).observe(stage)

  resize()
  readColors()

  /* p5.js sketchbook ---------------------------------------------- */

  const USER = 'pasha.korolchukk'
  const items = section.querySelectorAll<HTMLButtonElement>('.shelf__item')
  const shelfFrame = section.querySelector<HTMLElement>('.js-shelf-frame')!
  const runBtn = section.querySelector<HTMLButtonElement>('.js-shelf-run')!
  const shelfTitle = section.querySelector<HTMLElement>('.js-shelf-title')!
  const shelfLink = section.querySelector<HTMLAnchorElement>('.js-shelf-link')!

  let selected = items[0]

  const select = (item: HTMLButtonElement, run: boolean) => {
    selected = item
    items.forEach((other) => {
      other.classList.toggle('is-active', other === item)
      other.setAttribute('aria-pressed', String(other === item))
    })

    const { id, title } = item.dataset
    shelfTitle.textContent = title!
    shelfLink.href = `https://editor.p5js.org/${USER}/sketches/${id}`

    shelfFrame.querySelector('iframe')?.remove()
    runBtn.hidden = run
    if (!run) return

    // The sketch only loads once someone asks for it
    const iframe = document.createElement('iframe')
    iframe.src = `https://editor.p5js.org/${USER}/embed/${id}`
    iframe.title = `${title} — p5.js sketch`
    iframe.setAttribute('loading', 'lazy')
    shelfFrame.appendChild(iframe)
    log(`> p5 run "${title}"`)
  }

  items.forEach((item) => item.addEventListener('click', () => select(item, true)))
  runBtn.addEventListener('click', () => select(selected, true))
  select(selected, false)
</script>

<style is:global>
  .play__stage {
    position: relative;
    height: clamp(340px, 68vh, 720px);
    border: 1px solid var(--fg);
  }

  .play__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .play__hud,
  .play__hint {
    position: absolute;
    pointer-events: none;
  }

  .play__hud {
    top: 12px;
    left: 14px;
    font-variant-numeric: tabular-nums;
  }

  .play__hint {
    right: 14px;
    bottom: 12px;
    left: 14px;
    opacity: 0.6;
    text-align: right;
  }

  .play__panel {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--fg);
    border-top: 0;
  }

  .play__group {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    gap: 10px;
    padding: 12px 14px;
    border-right: 1px solid var(--fg);
  }

  .play__group:last-child {
    justify-content: flex-end;
    border-right: 0;
  }

  .play__label {
    opacity: 0.6;
  }

  .play__panel button {
    padding: 8px 12px;
    border: 1px solid var(--fg);
    background: none;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .play__panel button:hover,
  .play__panel button.is-active {
    background: var(--fg);
    color: var(--bg);
  }

  .play__text {
    width: 13ch;
    padding: 6px 0;
    border: 0;
    border-bottom: 1px solid var(--fg);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
  }

  .play__panel input[type='range'] {
    width: clamp(90px, 10vw, 150px);
    accent-color: var(--accent);
  }

  .play__panel output {
    min-width: 4ch;
    font-variant-numeric: tabular-nums;
  }

  /* p5.js sketchbook */
  .shelf {
    margin-top: clamp(48px, 7vw, 104px);
  }

  .shelf__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--fg);
  }

  .shelf__head span:last-child {
    opacity: 0.6;
  }

  .shelf__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: start;
  }

  .shelf__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 4px 8px;
    width: 100%;
    padding: 16px 12px 16px 0;
    border: 0;
    border-bottom: 1px solid var(--fg);
    background: none;
    text-align: left;
    cursor: pointer;
    transition:
      padding 0.5s var(--ease),
      color 0.25s;
  }

  .shelf__item:hover,
  .shelf__item.is-active {
    padding-left: 12px;
    color: var(--accent);
  }

  .shelf__no {
    padding-top: 0.5em;
    opacity: 0.6;
  }

  .shelf__title {
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
  }

  .shelf__note {
    grid-column: 2;
    color: var(--fg);
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.7;
  }

  .shelf__view {
    position: sticky;
    top: calc(var(--head-h) + 20px);
    margin-top: 20px;
    border: 1px solid var(--fg);
  }

  .shelf__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    max-height: 70vh;
    width: 100%;
    background: repeating-linear-gradient(-45deg, transparent 0 11px, color-mix(in srgb, var(--fg) 14%, transparent) 11px 12px);
  }

  .shelf__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .shelf__run {
    position: relative;
    padding: 14px 22px;
    border: 1px solid var(--fg);
    background: var(--bg);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .shelf__run:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .shelf__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 10px 14px;
    border-top: 1px solid var(--fg);
  }

  @media (max-width: 900px) {
    .shelf__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .shelf__view {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 720px) {
    .play__group {
      flex-basis: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--fg);
    }

    .play__group:last-child {
      justify-content: flex-start;
      border-bottom: 0;
    }

    .play__hint {
      text-align: left;
    }
  }
</style>
