---
const menu = [
  { id: 'about', text: 'About' },
  { id: 'stack', text: 'Stack' },
  { id: 'work', text: 'Work' },
  { id: 'play', text: 'Play' },
  { id: 'terminal', text: 'Terminal' },
  { id: 'contact', text: 'Contact' },
]
---

<header class="head t-paper">
  <a href="#top" class="head__tile" aria-label="Pavel Korolczuk — back to top">
    <span class="head__tile-no">01</span>
    <span class="head__tile-sym">Pk</span>
  </a>

  <div class="head__console" aria-hidden="true">
    <pre class="head__console-out js-console"></pre>
  </div>

  <nav class="head__nav" aria-label="Sections">
    <ul>
      {
        menu.map((item, i) => (
          <li>
            <a href={'#' + item.id}>
              <span class="head__nav-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="js-scramble">{item.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="head__status">
    <span class="head__status-line">
      <span class="head__dot"></span>Open for projects
    </span>
    <span class="head__status-line">
      Poznań <time class="js-clock">--:--:--</time>
    </span>
  </div>

  <button class="head__theme js-theme" type="button" aria-label="Switch colour scheme">
    <span></span>
  </button>

  <div class="head__progress js-progress"></div>
</header>

<script>
  import { takeLog, hasLog, onReady, reducedMotion } from '../lib/log'
  import { scramble } from '../lib/scramble'

  const out = document.querySelector<HTMLElement>('.js-console')!
  const clock = document.querySelector<HTMLElement>('.js-clock')!
  const themeBtn = document.querySelector<HTMLElement>('.js-theme')!

  /* Nav: labels decode on hover ------------------------------------ */

  document.querySelectorAll<HTMLElement>('.head__nav a').forEach((link) => {
    const text = link.querySelector<HTMLElement>('.js-scramble')!
    link.addEventListener('pointerenter', () => scramble(text, 320))
  })

  /* Console ------------------------------------------------------- */

  const idle = [
    'Making pixels behave since 2021',
    'Deploying pixels with intention',
    'Animating the un-animatable',
    'Figma → code: pixel-perfect',
    'git commit -m "ship it"',
    'npm run build — done in 1.2s',
    'WordPress: custom plugin activated',
    'PrestaShop: theme compiled',
    'Core Web Vitals: all green',
    'Lighthouse: performance 98',
    'TouchDesigner: all nodes connected',
    'p5.js sketch: running at 60 fps',
    'GSAP timeline: ready',
    'z-index: 9999 // just in case',
    'Status: open for new projects',
  ]

  const KEEP = 3
  const done: string[] = []
  let target = ''
  let typed = ''
  let last = ''
  let started = false

  const render = () => {
    out.textContent = [...done.slice(-KEEP), typed].join('\n')
  }

  const pickIdle = () => {
    let msg = last
    while (msg === last) msg = idle[Math.floor(Math.random() * idle.length)]
    last = msg
    return msg
  }

  const step = () => {
    if (document.hidden) return setTimeout(step, 600)

    // Nothing in flight: pick the next line
    if (!target) {
      const queued = takeLog()
      target = queued ?? pickIdle()
      typed = ''

      if (reducedMotion()) {
        done.push(target)
        target = ''
        render()
        return setTimeout(step, 3500)
      }

      return setTimeout(step, queued ? 60 : 250)
    }

    // Type one character
    const char = target.charAt(typed.length)
    typed += char
    render()

    if (typed.length >= target.length) {
      done.push(typed)
      if (done.length > KEEP) done.shift()
      typed = ''
      target = ''
      render()
      return setTimeout(step, hasLog() ? 120 : 2200)
    }

    // Something is waiting: hurry up
    if (hasLog()) return setTimeout(step, 6)

    const delay = char === '…' || char === '.' ? 320 : char === ',' || char === ' ' ? 70 : 22
    setTimeout(step, delay)
  }

  const start = () => {
    if (started) return
    started = true
    step()
  }

  onReady(start)
  setTimeout(start, 4000)

  /* Clock --------------------------------------------------------- */

  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Warsaw',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  })

  const tick = () => {
    clock.textContent = fmt.format(new Date())
  }
  tick()
  setInterval(tick, 1000)

  /* Theme --------------------------------------------------------- */

  const setTheme = (dark: boolean) => {
    document.documentElement.classList.toggle('is-dark', dark)
    try {
      localStorage.setItem('pk-theme', dark ? 'dark' : 'light')
    } catch {}
    document.dispatchEvent(new CustomEvent('pk:theme'))
  }

  themeBtn.addEventListener('click', () => {
    setTheme(!document.documentElement.classList.contains('is-dark'))
  })

  document.addEventListener('pk:toggle-theme', () => {
    setTheme(!document.documentElement.classList.contains('is-dark'))
  })
</script>

<style is:global>
  .head {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: stretch;
    height: var(--head-h);
    border-bottom: 1px solid var(--fg);
  }

  .head > * + * {
    border-left: 1px solid var(--fg);
  }

  /* Tile logo */
  .head__tile {
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 var(--head-h);
    text-decoration: none;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .head__tile:hover {
    background: var(--accent);
    color: var(--paper);
  }

  .head__tile-no {
    position: absolute;
    top: 7px;
    left: 8px;
    font: 500 9px / 1 var(--f-mono);
  }

  .head__tile-sym {
    font: 900 34px / 1 var(--f-display);
    transform: translateY(3px);
  }

  /* Console */
  .head__console {
    display: flex;
    align-items: flex-end;
    flex: 1 1 0;
    min-width: 0;
    padding: 10px 16px;
    overflow: hidden;
  }

  .head__console-out {
    width: 100%;
    font: 500 10px / 1.4 var(--f-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .head__console-out::after {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: -0.15em;
    animation: head-caret 1s steps(1) infinite;
    content: '';
  }

  @keyframes head-caret {
    50% {
      opacity: 0;
    }
  }

  /* Nav */
  .head__nav ul {
    display: flex;
    height: 100%;
  }

  .head__nav a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding: 0 clamp(12px, 1.5vw, 26px);
    font: 500 12px / 1 var(--f-mono);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    overflow: hidden;
  }

  .head__nav a::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--fg);
    transform: translateY(101%);
    transition: transform 0.45s var(--ease);
    content: '';
  }

  .head__nav a:hover {
    color: var(--bg);
  }

  .head__nav a:hover::before {
    transform: none;
  }

  .head__nav-no {
    font-size: 9px;
    opacity: 0.55;
  }

  /* Status */
  .head__status {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 0 18px;
    font: 500 10px / 1 var(--f-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .head__status time {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .head__dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: head-pulse 2s ease-in-out infinite;
  }

  @keyframes head-pulse {
    50% {
      opacity: 0.25;
    }
  }

  /* Theme switch */
  .head__theme {
    display: grid;
    place-items: center;
    flex: 0 0 56px;
    padding: 0;
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    background: none;
    cursor: pointer;
  }

  .head__theme span {
    width: 18px;
    height: 18px;
    border: 1px solid var(--fg);
    border-radius: 50%;
    background: linear-gradient(90deg, var(--fg) 50%, transparent 50%);
    transition: transform 0.6s var(--ease);
  }

  .head__theme:hover span {
    transform: rotate(180deg);
  }

  /* Scroll progress */
  .head__progress {
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 3px;
    border: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @media (max-width: 1280px) {
    .head__nav-no {
      display: none;
    }
  }

  @media (max-width: 1060px) {
    .head__nav {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .head__status-line:last-child {
      display: none;
    }

    .head__status {
      padding: 0 12px;
      font-size: 9px;
    }

    .head__console {
      padding: 8px 10px;
    }

    .head__console-out {
      font-size: 8px;
    }

    .head__theme {
      flex-basis: 44px;
    }

    .head__tile-sym {
      font-size: 28px;
    }
  }

  @media (max-width: 480px) {
    .head__status {
      display: none;
    }
  }
</style>
