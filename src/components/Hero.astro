---
// The second headline line cycles through these.
const words = ['Websites', 'Online shops', 'Plugins', 'Installations', 'Something new']
---

<section id="top" class="hero t-paper">
  <canvas class="hero__field js-field" aria-hidden="true"></canvas>

  <div class="hero__top mono">
    <h1 class="hero__name">
      <strong class="display">Pavel Korolczuk</strong>
      <span>Front-end developer &amp; creative technologist</span>
    </h1>
    <span class="hero__hint" aria-hidden="true">Move the cursor · click the field</span>
  </div>

  <p class="hero__title display" aria-label={`Let's build ${words.join(', ').toLowerCase()}.`}>
    <span class="hero__line" aria-hidden="true">
      <span class="hero__line-in">Let's build</span>
    </span>
    <span class="hero__line" aria-hidden="true">
      <span class="hero__line-in hero__word"><span class="js-hero-word" data-words={words.join('|')}>{words[0]}</span></span>
    </span>
  </p>

  <div class="hero__foot">
    <p class="hero__lead serif js-hero-fade">
      Bring the idea or the design. I'll bring fast, careful front-end —
      <em>and interactive pieces for when a page isn't enough.</em>
    </p>

    <dl class="hero__meta mono js-hero-fade">
      <div>
        <dt>Stack</dt>
        <dd>WordPress · PrestaShop · JS · creative code</dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>Poznań, PL — 52.41° N 16.93° E</dd>
      </div>
      <div>
        <dt>Next</dt>
        <dd><a href="#about" class="ul">Scroll to begin ↓</a></dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { log, onReady, reducedMotion } from '../lib/log'
  import { scramble } from '../lib/scramble'

  const hero = document.querySelector<HTMLElement>('.hero')!
  const canvas = hero.querySelector<HTMLCanvasElement>('.js-field')!
  const ctx = canvas.getContext('2d')!
  const foot = hero.querySelector<HTMLElement>('.hero__foot')!
  const topRow = hero.querySelector<HTMLElement>('.hero__top')!
  const calm = reducedMotion()

  let running = false

  /* Intro + rotating word ----------------------------------------- */

  const lines = hero.querySelectorAll('.hero__line-in')
  const fades = hero.querySelectorAll('.js-hero-fade')
  const word = hero.querySelector<HTMLElement>('.js-hero-word')!
  const words = word.dataset.words!.split('|')
  let wordAt = 0

  const nextWord = () => {
    if (!running || document.hidden) return
    wordAt = (wordAt + 1) % words.length
    word.dataset.text = words[wordAt]
    scramble(word, 650)
  }

  if (!calm) {
    gsap.set(lines, { yPercent: 112 })
    gsap.set(fades, { opacity: 0, y: 24 })

    onReady(() => {
      gsap.to(lines, { yPercent: 0, duration: 1.3, ease: 'expo.out', stagger: 0.1 })
      gsap.to(fades, { opacity: 1, y: 0, duration: 1.2, ease: 'expo.out', stagger: 0.12, delay: 0.45 })
      setInterval(nextWord, 2600)
    })
  }

  /* ASCII field ------------------------------------------------------
     A sheet of monospace characters. Slow interference waves decide how
     "dense" each cell is; the cursor and clicks add to it and turn the
     characters they touch into the accent colour. */

  const RAMP = '      ..::--=+*#%@'
  const WAVE_LIFE = 1.8
  const WAVE_SPEED = 520
  const WAVE_WIDTH = 80

  let w = 0
  let h = 0
  let size = 13
  let cw = 8
  let ch = 20
  let cols = 0
  let rows = 0
  let ink = '#160000'
  let hotInk = '#f40c3f'
  let raf = 0
  let last = 0
  let quietFrom = 9999
  let quietTo = 44
  let waves: { x: number; y: number; t: number }[] = []

  const mouse = { x: -9999, y: -9999, sx: -9999, sy: -9999, active: false }

  const readColors = () => {
    const cs = getComputedStyle(hero)
    ink = cs.getPropertyValue('--fg').trim() || ink
    hotInk = cs.getPropertyValue('--accent').trim() || hotInk
  }

  const setFont = () => {
    ctx.font = `500 ${size}px "JetBrains Mono Variable", ui-monospace, Consolas, monospace`
    ctx.textBaseline = 'top'
  }

  const resize = () => {
    w = hero.clientWidth
    h = hero.clientHeight
    const dpr = Math.min(window.devicePixelRatio || 1, 2)

    canvas.width = Math.round(w * dpr)
    canvas.height = Math.round(h * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)

    size = w < 720 ? 11 : 13
    setFont()
    cw = ctx.measureText('M').width || size * 0.6
    ch = Math.round(size * 1.55)
    cols = Math.ceil(w / cw) + 1
    rows = Math.ceil(h / ch) + 1
    quietFrom = foot.offsetTop - 12
    quietTo = topRow.offsetTop + topRow.offsetHeight + 8

    readColors()
    if (!running) draw(0, true)
  }

  // Characters picked up by the cursor or a wave: col, row, glyph index
  let hot: number[] = []

  const draw = (time: number, force = false) => {
    if (running) raf = requestAnimationFrame(draw)

    // ~30 fps is plenty for text
    if (!force && time - last < 32) return
    last = time

    const t = time / 1000
    const top = RAMP.length - 1

    mouse.sx += (mouse.x - mouse.sx) * 0.2
    mouse.sy += (mouse.y - mouse.sy) * 0.2
    if (waves.length) waves = waves.filter((wave) => t - wave.t < WAVE_LIFE)

    ctx.clearRect(0, 0, w, h)
    setFont()
    ctx.fillStyle = ink
    ctx.globalAlpha = 0.26
    hot.length = 0

    for (let r = 0; r < rows; r++) {
      const py = r * ch
      let line = ''

      // Keep the field quiet behind the small text at the top and bottom
      const mask = Math.max(0, Math.min(1, (py - quietTo) / 90, (quietFrom - py) / 90))

      for (let c = 0; c < cols; c++) {
        const px = c * cw

        // Four slow sine sheets interfering with each other, 0..1
        let v =
          (Math.sin(px * 0.0062 + py * 0.0021 + t * 0.5) +
            Math.cos(py * 0.0088 - px * 0.0017 - t * 0.37) +
            Math.sin((px + py) * 0.0041 + t * 0.23) +
            Math.sin(px * 0.0027 - py * 0.0049 - t * 0.15) +
            4) /
          8
        v = v * v * (3 - 2 * v) * mask

        let heat = 0

        if (mouse.active) {
          const d = Math.hypot(px - mouse.sx, py - mouse.sy)
          if (d < 200) heat = (1 - d / 200) ** 2
        }

        for (const wave of waves) {
          const age = t - wave.t
          const off = Math.abs(Math.hypot(px - wave.x, py - wave.y) - age * WAVE_SPEED)
          if (off < WAVE_WIDTH) heat = Math.max(heat, (1 - off / WAVE_WIDTH) * (1 - age / WAVE_LIFE))
        }

        const index = Math.min(top, Math.floor((v + heat * 0.7) * RAMP.length))

        if (heat > 0.12 && index > 2) {
          hot.push(c, r, Math.max(index, 6))
          line += ' '
        } else {
          line += RAMP[index]
        }
      }

      ctx.fillText(line, 0, py)
    }

    ctx.fillStyle = hotInk
    ctx.globalAlpha = 1
    for (let i = 0; i < hot.length; i += 3) {
      ctx.fillText(RAMP[Math.min(top, hot[i + 2])], hot[i] * cw, hot[i + 1] * ch)
    }
  }

  const setRunning = (on: boolean) => {
    if (on === running) return
    running = on
    cancelAnimationFrame(raf)
    if (on) raf = requestAnimationFrame(draw)
  }

  hero.addEventListener('pointermove', (e) => {
    const rect = hero.getBoundingClientRect()
    mouse.x = e.clientX - rect.left
    mouse.y = e.clientY - rect.top
    if (!mouse.active) {
      mouse.sx = mouse.x
      mouse.sy = mouse.y
      mouse.active = true
    }
  })

  hero.addEventListener('pointerleave', () => {
    mouse.active = false
  })

  hero.addEventListener('pointerdown', (e) => {
    if (!running || (e.target as Element).closest('a')) return
    const rect = hero.getBoundingClientRect()
    waves.push({ x: e.clientX - rect.left, y: e.clientY - rect.top, t: performance.now() / 1000 })
    if (waves.length > 5) waves.shift()
    log('> pulse sent')
  })

  new ResizeObserver(resize).observe(hero)
  document.fonts?.ready.then(resize)
  document.addEventListener('pk:theme', () => {
    readColors()
    if (!running) draw(0, true)
  })

  resize()

  if (!calm) {
    new IntersectionObserver(([entry]) => setRunning(entry.isIntersecting)).observe(hero)
  }
</script>

<style is:global>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 48px);
    min-height: calc(100svh - var(--head-h));
    padding: clamp(16px, 2vw, 28px) var(--pad) clamp(20px, 2.4vw, 32px);
    overflow: hidden;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero > :not(canvas) {
    position: relative;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .hero__name {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font: inherit;
  }

  .hero__name strong {
    font-size: clamp(1.9rem, 3vw, 3.2rem);
    line-height: 0.9;
  }

  .hero__name span,
  .hero__hint {
    opacity: 0.6;
  }

  .hero__title {
    margin-block: auto;
    font-size: min(12.4vw, 27vh);
    cursor: default;
  }

  .hero__line {
    display: block;
    padding-top: 0.06em;
    overflow: hidden;
  }

  .hero__line-in {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__word {
    color: var(--accent);
  }

  /* Block caret after the cycling word */
  .hero__word::after {
    display: inline-block;
    width: 0.3em;
    height: 0.72em;
    margin-left: 0.06em;
    background: currentColor;
    animation: head-caret 1s steps(1) infinite;
    content: '';
  }

  .hero__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 24px clamp(24px, 5vw, 80px);
    padding-top: clamp(14px, 1.6vw, 22px);
    border-top: 1px solid var(--fg);
  }

  .hero__lead {
    max-width: 22em;
    font-size: clamp(1.25rem, 2vw, 2.1rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .hero__lead em {
    color: var(--accent);
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px clamp(16px, 3vw, 40px);
  }

  .hero__meta dt {
    margin-bottom: 6px;
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .hero__hint {
      display: none;
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .hero__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
